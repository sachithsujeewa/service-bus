# Local development defaults (docker-compose overrides)
POSTGRES_USER=rambase
POSTGRES_PASSWORD=rambase

# API keys (must match docker-compose Auth__* and app config)
SOURCE_API_KEY=source-dev-key
PARTNER_API_KEY=partner-dev-key
ADMIN_API_KEY=admin-dev-key

# URLs when running demo from host
API_URL=http://localhost:8080
SOURCE_URL=http://localhost:5101
PARTNER_URL=http://localhost:5102
